# = 뒤에 값을 쓰고 저장하세요. 이 파일(.env)은 GitHub 에 올라가지 않습니다.

# 한투 KIS Developers 에서 받은 모의투자 앱키
KIS_APP_KEY=
# 한투 KIS Developers 에서 받은 모의투자 시크릿
KIS_APP_SECRET=
# 모의투자 계좌번호 8자리 (뒤에 -01 은 안 써도 자동으로 붙음)
KIS_ACCOUNT=

# 이 사이트 로그인 비밀번호 (8자 이상, 마음대로 정하기)
APP_PASSWORD=

# 텔레그램 로그인 승인 (비워 두면 비밀번호만으로 로그인)
# BotFather 가 준 봇 토큰
TELEGRAM_BOT_TOKEN=
# 내 chat id (python -m app.telegram_setup 을 실행하면 자동으로 채워짐)
TELEGRAM_CHAT_ID=


# ---- 아래는 그대로 두면 됩니다 ----
KIS_MODE=mock
KIS_RPS=1
COOKIE_SECURE=false
ORDER_LIMIT_WON=3000000
