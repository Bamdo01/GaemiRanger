# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git 에 올라가지 않는다.
# 키와 비밀번호는 절대 이 예시 파일이나 코드에 쓰지 않는다.

# 한투 Open API (KIS Developers 에서 발급). 지금은 모의투자만 쓴다.
KIS_MODE=mock
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 계좌번호: 앞 8자리-뒤 2자리 (예: 50123456-01)
KIS_ACCOUNT=
# 초당 호출 수. 모의투자는 낮게 둔다.
KIS_RPS=2

# 로그인 비밀번호 해시. 직접 쓰지 말고 아래 명령으로 만들어 붙여 넣는다:
#   .venv\Scripts\python -m app.hashpw
APP_PASSWORD_HASH=
# 로그인 쿠키 서명용 임의 문자열 (python -c "import secrets;print(secrets.token_hex(32))")
SESSION_SECRET=
# HTTPS 로 서비스할 때 true (클라우드). 이 PC 에서 http 로 쓸 때 false
COOKIE_SECURE=false

# 1회 주문 한도 (원). 설정 화면(C1)을 만들기 전 임시값
ORDER_LIMIT_WON=3000000
