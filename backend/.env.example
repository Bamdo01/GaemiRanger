# = 뒤에 값을 쓰고 저장하세요. 이 파일(.env)은 GitHub 에 올라가지 않습니다.

# 한투 KIS Developers 에서 받은 모의투자 앱키
KIS_APP_KEY=
# 한투 KIS Developers 에서 받은 모의투자 시크릿
KIS_APP_SECRET=
# 모의투자 계좌번호 (예: 50123456-01)
KIS_ACCOUNT=

# 이 사이트 로그인 비밀번호 (8자 이상, 마음대로 정하기)
APP_PASSWORD=


# ---- 아래는 그대로 두면 됩니다 ----
KIS_MODE=mock
KIS_RPS=2
COOKIE_SECURE=false
ORDER_LIMIT_WON=3000000
